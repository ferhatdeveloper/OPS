# Logo Tiger Objects REST — örnek ortam değişkenleri
# Gerçek api_key / client_secret ASLA commit edilmemeli.
# Yerel kopya: cp .env.example .env  (veya mevcut .env)

# OpenRouter (AI / sosyal medya görsel) — gerçek key .env'e; commit etme
# OPENROUTER_API_KEY=

# Host:port (şema opsiyonel; uygulama /api/v1 ekler)
LOGO_TIGER_BASE_URL=http://185.206.80.132:32001

# Help / query api_key (çoğu kurulumda client_id ile aynı olabilir)
LOGO_TIGER_API_KEY=

# OAuth (POST /token) — Basic client_id:client_secret yedek kullanılır
LOGO_TIGER_CLIENT_ID=
LOGO_TIGER_CLIENT_SECRET=
LOGO_TIGER_USERNAME=
LOGO_TIGER_PASSWORD=

# Firma / dönem
LOGO_TIGER_FIRM_NR=1
LOGO_TIGER_PERIOD_NR=1
