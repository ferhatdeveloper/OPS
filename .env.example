# Logo Tiger Objects REST — örnek ortam değişkenleri
# Gerçek api_key / client_secret ASLA commit edilmemeli.

# Host:port (şema opsiyonel; uygulama /api/v1 ekler)
LOGO_TIGER_BASE_URL=http://127.0.0.1:32001

# Help / query api_key (çoğu kurulumda client_id ile aynı olabilir)
LOGO_TIGER_API_KEY=

# OAuth (POST /token)
LOGO_TIGER_CLIENT_ID=
LOGO_TIGER_CLIENT_SECRET=
LOGO_TIGER_USERNAME=
LOGO_TIGER_PASSWORD=

# Firma / dönem
LOGO_TIGER_FIRM_NR=1
LOGO_TIGER_PERIOD_NR=1
